# alembic-smart: Zsh completion for Alembic; runner integrations are optional.
# Completions never run Alembic, load env.py, access a database, or eval input.
# Source after Zsh's compinit / Oh My Zsh startup.

# %x is the file currently being sourced (unlike %N, which may be a function).
typeset -g _alembic_smart_home="${${(%):-%x}:A:h}"

# Optional convenience shortcut for uv users (off by default).
# Set ALEMBIC_SMART_WRAP_UV=1 before loading the plugin to enable it.
if [[ ${ALEMBIC_SMART_WRAP_UV:-0} == 1 ]] && (( $+commands[uv] )); then
  function alembic() {
    command uv run alembic "$@"
  }
fi

function _alembic_smart_revisions() {
  emulate -L zsh
  # Completion helpers such as _describe require extended glob patterns.
  setopt extendedglob
  local mode="${1:-all}" config="${2:-}" name="${3:-alembic}"
  local -a values
  case "$mode" in
    upgrade)
      values=('head:latest revision' 'heads:all branch heads' '+1:one revision forward' 'base:beginning')
      ;;
    downgrade)
      values=('base:before the first revision' '-1:one revision backward' 'head:latest revision')
      ;;
    stamp)
      values=('head:latest revision' 'heads:all branch heads' 'base:before the first revision')
      ;;
    show)
      values=('head:latest revision' 'heads:all branch heads' 'current:database revision' 'base:beginning')
      ;;
    *)
      values=('head:latest revision' 'heads:all branch heads' 'base:beginning')
      ;;
  esac

  # Python parses config files and revision ASTs as DATA only. It never imports
  # app code and never evaluates migration source. Errors are non-fatal.
  if (( $+commands[python3] )) && [[ -f "$_alembic_smart_home/revisions.py" ]]; then
    local helper_mode=all
    [[ $mode == heads ]] && helper_mode=heads
    local -a project_revisions
    project_revisions=( "${(@f)$(command python3 "$_alembic_smart_home/revisions.py" --cwd "$PWD" --config "$config" --name "$name" --mode "$helper_mode" 2>/dev/null)}" )
    (( ${#project_revisions} )) && values+=( "${project_revisions[@]}" )
  fi
  _describe -t revisions 'Alembic revisions' values
}

function _alembic_smart_templates() {
  local -a templates=(
    'generic:regular project'
    'async:async project'
    'multidb:multiple databases'
    'pyproject:pyproject config'
    'pyproject_async:async pyproject config'
  )
  _describe -t templates 'Alembic templates' templates
}

function _alembic_smart() {
  emulate -L zsh
  setopt extendedglob no_aliases
  local curcontext="$curcontext" state state_descr
  local -a line commands_list opts
  local -A opt_args

  _arguments -C -A '-*' \
    '(-h --help)'{-h,--help}'[show help]' \
    '--version[show version]' \
    '(-c --config)'{-c+,--config=}'[config file]:config file:_files -g "*.(ini|toml)"' \
    '(-n --name)'{-n+,--name=}'[configuration section]:section:' \
    '*-x+[pass setting to env.py]:setting:' \
    '--raiseerr[show error traceback]' \
    '(-q --quiet)'{-q,--quiet}'[quiet]' \
    '1:command:->command' \
    '*::arguments:->arguments' && return 0

  case "$state" in
    command)
      commands_list=(
        'branches:show branching points'
        'check:check for pending autogenerated migrations'
        'current:show applied revision'
        'downgrade:roll back migrations'
        'edit:open a revision in your editor'
        'ensure_version:create version table if missing'
        'heads:list latest revisions'
        'history:show revision history'
        'init:initialize migrations directory'
        'list_templates:list init templates'
        'merge:merge revisions'
        'revision:create migration revision'
        'show:inspect a revision'
        'stamp:set revision without running migrations'
        'upgrade:apply migrations'
      )
      _describe -t commands 'Alembic commands' commands_list
      return
      ;;
    arguments)
      local subcmd="$words[1]"
      local config="${opt_args[-c]:-${opt_args[--config]:-}}"
      local conf_name="${opt_args[-n]:-${opt_args[--name]:-alembic}}"
      ;;
    *) return 1 ;;
  esac

  opts=( '(-h --help)'{-h,--help}'[show help]' )
  case "$subcmd" in
    upgrade|downgrade)
      opts+=(
        '--sql[generate SQL without applying]'
        '--tag=[pass tag to env.py]:tag:'
        '1:revision: _alembic_smart_revisions "$subcmd" "$config" "$conf_name"'
      )
      ;;
    stamp)
      opts+=(
        '--sql[generate SQL]'
        '--tag=[pass tag to env.py]:tag:'
        '--purge[remove all version entries first]'
        '*:revision: _alembic_smart_revisions stamp "$config" "$conf_name"'
      )
      ;;
    revision|merge)
      opts+=(
        '(-m --message)'{-m+,--message=}'[migration message]:message:'
        '--branch-label=[branch name]:branch label:'
        '--rev-id=[custom revision id]:revision id:'
      )
      if [[ $subcmd == revision ]]; then
        opts+=(
          '--autogenerate[compare metadata with database]'
          '--sql[offline SQL script]'
          '--head=[base revision]:revision: _alembic_smart_revisions all "$config" "$conf_name"'
          '--splice[branch from non-head revision]'
          '--version-path=[output directory]:directory:_directories'
          '--depends-on=[dependent revision]:revision: _alembic_smart_revisions all "$config" "$conf_name"'
        )
      else
        opts+=( '*:revision: _alembic_smart_revisions heads "$config" "$conf_name"' )
      fi
      ;;
    edit|show)
      opts+=( '1:revision: _alembic_smart_revisions "$subcmd" "$config" "$conf_name"' )
      ;;
    history)
      opts+=(
        '(-r --rev-range)'{-r+,--rev-range=}'[revision range]:revision range: _alembic_smart_revisions all "$config" "$conf_name"'
        '(-v --verbose)'{-v,--verbose}'[verbose]'
        '(-i --indicate-current)'{-i,--indicate-current}'[mark current revision]'
      )
      ;;
    current)
      opts+=(
        '(-v --verbose)'{-v,--verbose}'[verbose]'
        '(-c --check-heads)'{-c,--check-heads}'[check if database is up to date]'
      )
      ;;
    branches|heads)
      opts+=( '(-v --verbose)'{-v,--verbose}'[verbose]' )
      [[ $subcmd == heads ]] && opts+=( '--resolve-dependencies[show heads with dependencies]' )
      ;;
    init)
      opts+=(
        '(-t --template)'{-t+,--template=}'[template]:template:_alembic_smart_templates'
        '--package[generate package init files]'
        '1:directory:_directories'
      )
      ;;
  esac
  _arguments -S "${opts[@]}"
}

# Preserve the installed uv completer, handling only the simple, common syntax
#   uv run alembic <args>
# Everything else is delegated unchanged to uv's own completion.
function _alembic_smart_uv() {
  emulate -L zsh
  # Completion helpers such as _describe require extended glob patterns.
  setopt extendedglob
  if [[ "${words[2]-}" == run && "${words[3]-}" == alembic ]] && (( CURRENT >= 4 )); then
    local -a subwords=( "${(@)words[3,-1]}" )
    local -a words=( "${subwords[@]}" )
    local -i CURRENT=$(( CURRENT - 2 ))
    _alembic_smart
  elif [[ -n ${_alembic_smart_original_uv:-} ]]; then
    "$_alembic_smart_original_uv" "$@"
  else
    return 1
  fi
}

function alembic_smart_enable_uv() {
  # Must be called AFTER `eval "$(uv generate-shell-completion zsh)"`.
  if [[ ${_comps[uv]:-} == _alembic_smart_uv ]]; then
    return 0
  fi
  if [[ -z ${_comps[uv]:-} ]]; then
    print -u2 -- 'alembic-smart: initialize uv shell completion before enabling this integration'
    return 1
  fi
  typeset -g _alembic_smart_original_uv="${_comps[uv]}"
  compdef _alembic_smart_uv uv
}

if (( $+functions[compdef] )); then
  compdef _alembic_smart alembic
fi
