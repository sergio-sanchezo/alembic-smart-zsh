# alembic-smart: Zsh completion for Alembic; runner integrations are optional.
# Completions never run Alembic, load env.py, access a database, or eval input.
# Source after Zsh's compinit / Oh My Zsh startup.

# %x is the file currently being sourced (unlike %N, which may be a function).
typeset -g _alembic_smart_home="${${(%):-%x}:A:h}"

# Optional convenience shortcut for uv users (off by default).
# Set ALEMBIC_SMART_WRAP_UV=1 before loading the plugin to enable it.
if [[ ${ALEMBIC_SMART_WRAP_UV:-0} == 1 ]] && (( $+commands[uv] )); then
  function alembic() {
    command uv run alembic "$@"
  }
fi

function _alembic_smart_revisions() {
  emulate -L zsh
  # Completion helpers such as _describe require extended glob patterns.
  setopt extendedglob
  local mode="${1:-all}" config="${2:-}" name="${3:-alembic}"
  local -a values
  case "$mode" in
    upgrade)
      values=('head:latest revision' 'heads:all branch heads' '+1:one revision forward' 'base:beginning')
      ;;
    downgrade)
      values=('base:before the first revision' '-1:one revision backward' 'head:latest revision')
      ;;
    stamp)
      values=('head:latest revision' 'heads:all branch heads' 'base:before the first revision')
      ;;
    show)
      values=('head:latest revision' 'heads:all branch heads' 'current:database revision' 'base:beginning')
      ;;
    *)
      values=('head:latest revision' 'heads:all branch heads' 'base:beginning')
      ;;
  esac

  # Python parses config files and revision ASTs as DATA only. It never imports
  # app code and never evaluates migration source. Errors are non-fatal.
  if (( $+commands[python3] )) && [[ -f "$_alembic_smart_home/revisions.py" ]]; then
    local helper_mode=all
    [[ $mode == heads ]] && helper_mode=heads
    local -a project_revisions
    project_revisions=( "${(@f)$(command python3 "$_alembic_smart_home/revisions.py" --cwd "$PWD" --config "$config" --name "$name" --mode "$helper_mode" 2>/dev/null)}" )
    (( ${#project_revisions} )) && values+=( "${project_revisions[@]}" )
  fi
  _describe -t revisions 'Alembic revisions' values
}

function _alembic_smart() {
  emulate -L zsh
  # Completion helpers such as _describe require extended glob patterns.
  setopt extendedglob
  setopt local_options no_aliases

  local -a commands_list global_opts opts
  commands_list=(
    'branches:show branching points'
    'check:check for pending autogenerated migrations'
    'current:show applied revision'
    'downgrade:roll back migrations'
    'edit:open a revision in your editor'
    'ensure_version:create version table if missing'
    'heads:list latest revisions'
    'history:show revision history'
    'init:initialize migrations directory'
    'list_templates:list init templates'
    'merge:merge revisions'
    'revision:create migration revision'
    'show:inspect a revision'
    'stamp:set revision without running migrations'
    'upgrade:apply migrations'
  )
  global_opts=(
    '-h:show help' '--help:show help'
    '--version:show version' '-c:config file' '--config:config file'
    '-n:configuration section' '--name:configuration section'
    '-x:pass setting to env.py' '--raiseerr:show error traceback'
    '-q:quiet' '--quiet:quiet'
  )

  local i subcmd='' config='' conf_name='alembic'
  for (( i=2; i<CURRENT; i++ )); do
    case "${words[i]}" in
      -c|--config)
        if (( i+1 < CURRENT )); then config="${words[i+1]}"; (( i++ )); fi
        ;;
      --config=*) config="${words[i]#--config=}" ;;
      -c?*) config="${words[i]#-c}" ;;
      -n|--name)
        if (( i+1 < CURRENT )); then conf_name="${words[i+1]}"; (( i++ )); fi
        ;;
      --name=*) conf_name="${words[i]#--name=}" ;;
      -n?*) conf_name="${words[i]#-n}" ;;
      -x)
        (( i++ ))
        ;;
      -*) ;;
      *)
        subcmd="${words[i]}"
        break
        ;;
    esac
  done

  local prev=''
  (( CURRENT > 1 )) && prev="${words[CURRENT-1]}"

  # Option values that use a separate word.
  case "$prev" in
    -c|--config)
      if [[ "$subcmd" == current ]]; then
        # 'alembic current -c' means --check-heads, not --config.
        return
      fi
      _files -g '*.(ini|toml)' && return
      return
      ;;
    --version-path)
      _files -/ && return
      return
      ;;
    -m|--message|-x|--x-arg|-n|--name|--rev-id|--branch-label|--tag)
      _message 'value (type manually)'
      return
      ;;
    --head|--depends-on|-r|--rev-range)
      _alembic_smart_revisions all "$config" "$conf_name"
      return
      ;;
    -t|--template)
      local -a templates=( 'generic:regular project' 'async:async project' 'multidb:multiple databases' 'pyproject:pyproject config' 'pyproject_async:async pyproject config' )
      _describe -t templates 'Alembic templates' templates
      return
      ;;
  esac

  # Option values using --key=value.
  if [[ $PREFIX == --config=* ]]; then
    compset -P --config=
    _files -g '*.(ini|toml)'
    return
  elif [[ $PREFIX == --version-path=* ]]; then
    compset -P --version-path=
    _files -/
    return
  elif [[ $PREFIX == --head=* || $PREFIX == --depends-on=* || $PREFIX == --rev-range=* ]]; then
    compset -P '*='
    _alembic_smart_revisions all "$config" "$conf_name"
    return
  elif [[ $PREFIX == --template=* ]]; then
    compset -P --template=
    local -a templates=( 'generic:regular project' 'async:async project' 'multidb:multiple databases' 'pyproject:pyproject config' 'pyproject_async:async pyproject config' )
    _describe -t templates 'Alembic templates' templates
    return
  fi

  if [[ -z $subcmd ]]; then
    _describe -t commands 'Alembic commands' commands_list
    _describe -t options 'Global options' global_opts
    return 0
  fi

  case "$subcmd" in
    upgrade|downgrade)
      opts=( '--sql:generate SQL without applying' '--tag:pass tag to env.py' '-h:help' '--help:help' )
      _describe -t options 'Options' opts
      _alembic_smart_revisions "$subcmd" "$config" "$conf_name"
      ;;
    stamp)
      opts=( '--sql:generate SQL' '--tag:pass tag to env.py' '--purge:remove all version entries first' '-h:help' '--help:help' )
      _describe -t options 'Options' opts
      _alembic_smart_revisions stamp "$config" "$conf_name"
      ;;
    revision)
      opts=(
        '-m:migration message' '--message:migration message'
        '--autogenerate:compare metadata with database'
        '--sql:offline SQL script' '--head:base revision'
        '--splice:branch from non-head revision'
        '--branch-label:branch name' '--version-path:output directory'
        '--rev-id:custom revision id' '--depends-on:dependent revision'
        '-h:help' '--help:help'
      )
      _describe -t options 'Revision options' opts
      ;;
    merge)
      opts=( '-m:merge message' '--message:merge message' '--branch-label:branch name' '--rev-id:custom revision id' '-h:help' '--help:help' )
      _describe -t options 'Merge options' opts
      _alembic_smart_revisions heads "$config" "$conf_name"
      ;;
    edit|show)
      opts=( '-h:help' '--help:help' )
      _describe -t options 'Options' opts
      _alembic_smart_revisions "$subcmd" "$config" "$conf_name"
      ;;
    history)
      opts=( '-r:revision range' '--rev-range:revision range' '-v:verbose' '--verbose:verbose' '-i:mark current revision' '--indicate-current:mark current revision' '-h:help' '--help:help' )
      _describe -t options 'History options' opts
      ;;
    current)
      opts=( '-v:verbose' '--verbose:verbose' '-c:check if database is up to date' '--check-heads:check if database is up to date' '-h:help' '--help:help' )
      _describe -t options 'Current options' opts
      ;;
    branches|heads)
      opts=( '-v:verbose' '--verbose:verbose' '-h:help' '--help:help' )
      [[ $subcmd == heads ]] && opts+=( '--resolve-dependencies:show heads with dependencies' )
      _describe -t options 'Options' opts
      ;;
    init)
      opts=( '-t:template' '--template:template' '--package:generate package init files' '-h:help' '--help:help' )
      _describe -t options 'Init options' opts
      _files -/
      ;;
    *)
      opts=( '-h:help' '--help:help' )
      _describe -t options 'Options' opts
      ;;
  esac
  return 0
}

# Preserve the installed uv completer, handling only the simple, common syntax
#   uv run alembic <args>
# Everything else is delegated unchanged to uv's own completion.
function _alembic_smart_uv() {
  emulate -L zsh
  # Completion helpers such as _describe require extended glob patterns.
  setopt extendedglob
  if [[ "${words[2]-}" == run && "${words[3]-}" == alembic ]] && (( CURRENT >= 4 )); then
    local -a subwords=( "${(@)words[3,-1]}" )
    local -a words=( "${subwords[@]}" )
    local -i CURRENT=$(( CURRENT - 2 ))
    _alembic_smart
  elif [[ -n ${_alembic_smart_original_uv:-} ]]; then
    "$_alembic_smart_original_uv" "$@"
  else
    return 1
  fi
}

function alembic_smart_enable_uv() {
  # Must be called AFTER `eval "$(uv generate-shell-completion zsh)"`.
  if [[ ${_comps[uv]:-} == _alembic_smart_uv ]]; then
    return 0
  fi
  if [[ -z ${_comps[uv]:-} ]]; then
    print -u2 -- 'alembic-smart: initialize uv shell completion before enabling this integration'
    return 1
  fi
  typeset -g _alembic_smart_original_uv="${_comps[uv]}"
  compdef _alembic_smart_uv uv
}

if (( $+functions[compdef] )); then
  compdef _alembic_smart alembic
fi
